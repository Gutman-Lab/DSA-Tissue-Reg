# Docker environment variables template
# Copy this to .env and customize with your values

# Frontend
VITE_API_BASE_URL=http://backend:8000/api

# Backend
DSA_BASE_URL=http://bdsa.pathology.emory.edu:8080/api/v1
DSAKEY=your_dsa_api_key_here

# Case Collection ID - collection containing all case folders
# Default: http://bdsa.pathology.emory.edu:8080/#collection/695d6a148c871f3a02969b00
CASE_COLLECTION_ID=695d6a148c871f3a02969b00

# User ID mapping (automatically set by run-docker.sh)
# USER_ID=1000
# GROUP_ID=1000
